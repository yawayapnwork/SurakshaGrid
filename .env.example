# Async SQLAlchemy requires the asyncpg driver prefix. Render's managed Postgres
# gives you a `postgresql://...` URL — rewrite the scheme to `postgresql+asyncpg://...`.
DATABASE_URL=postgresql+asyncpg://user:password@host:5432/surakshagrid

REDIS_URL=redis://localhost:6379/0

# Comma-separated list of allowed origins for CORS.
CORS_ORIGINS=http://localhost:3000,https://app.surakshagrid.example

# Must be at least 32 characters.
JWT_SECRET=change-me-to-a-long-random-secret-value

OSRM_BASE_URL=http://localhost:5000

ENVIRONMENT=development

# Optional: Cloudinary credentials for photo-verification uploads. Leave unset to disable.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

ADMIN_USERNAME=admin

# Required: Bcrypt hash of the admin/dispatcher password (must be generated fresh per deployment via get_password_hash).
# Generate using: python -c "from app.core.security import get_password_hash; print(get_password_hash('yourpassword'))"
ADMIN_PASSWORD=$2b$12$EXAMPLEPLACEHOLDERHASHDO_NOT_USE_IN_PRODUCTIONxxxxxxx

ACCESS_TOKEN_EXPIRE_MINUTES=60

# Shared secret n8n workflows must present when posting into the ingestion endpoints.
N8N_INGESTION_SECRET=surakshagrid-n8n-ingest-secret
# Optional: n8n webhook URLs the backend calls out to for SOS alerts / scenario triggers.
N8N_SOS_WEBHOOK_URL=
N8N_SCENARIO_WEBHOOK_URL=

# Optional: OpenWeatherMap API key used as a direct fallback when no n8n-ingested live
# rainfall reading exists near a requested location (see app/services/weather_service.py).
# Leave unset to rely solely on n8n-pushed readings via POST /risk-scores/live-rainfall.
OPENWEATHER_API_KEY=

# Optional: Twilio credentials for direct SMS alerting (POST /api/alerts/send-sms, plus
# automatic critical-SOS / dispatch-confirmation broadcasts below). Leave unset to disable.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Optional: comma-separated E.164 phone numbers of registered dispatchers/responders who
# automatically receive an SMS for a CRITICAL_TRAPPED SOS report or a completed dispatch
# round. Leave unset to disable the automatic broadcasts (the on-demand endpoint still works).
DISPATCHER_ALERT_PHONE_NUMBERS=

# Vision-language model used for photo verification.
VLM_MODEL_ID=vikhyatk/moondream2
VLM_MODEL_REVISION=2024-08-26

# "openai/whisper-small" balances multilingual (Hindi/Tamil/etc.) accuracy against
# inference speed on CPU-only hosts; swap to "openai/whisper-medium" or "-large-v3"
# for higher accuracy when GPU memory is available.
WHISPER_MODEL_ID=openai/whisper-small

NLLB_MODEL_ID=facebook/nllb-200-distilled-600M

# Kokoro TTS voice pack. 'a' = American English voice pack.
KOKORO_VOICE=af_heart
KOKORO_LANG_CODE=a

# Max ML models (VLM/Whisper/NLLB) allowed resident in memory at once. 1 is the safe
# default for small Render instances — loading a second model evicts the least-recently
# used one first. Set to 0 to disable eviction (keep everything cached) if your instance
# has enough RAM for all three at the same time, or 2 for partial headroom.
MAX_RESIDENT_MODELS=1
